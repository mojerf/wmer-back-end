APP_NAME=wmer
APP_ENV=local
APP_KEY=
# Never enable debug outside local development: it prints environment details in error pages.
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wmer_back_end
DB_USERNAME=wmer
DB_PASSWORD=change-me

# Angular front end (CORS + Sanctum SPA cookies). Hosts only, comma separated, with ports in development.
FRONTEND_URL=http://localhost:4200
# Browsers may call the API from these origins (comma separated; the SSR server runs on :4000).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:4000
SESSION_DOMAIN=localhost

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Used only by `php artisan db:seed` to create the administrator. Leave ADMIN_PASSWORD empty in production
# to get a random password printed once.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
